# Flashmandu sandbox secrets — written by `autohisab-business dev` into .flashmandu/
# Copy them here OR source from .flashmandu/sandbox-secrets.<app>.json in your
# own runtime. Do NOT commit real secrets.
#
# SECURITY: none of these may be prefixed with NEXT_PUBLIC_. That prefix inlines
# the value into the browser bundle, publishing your secret to every visitor.
# Read them only from Server Components, route handlers, or server actions.
FLASHMANDU_API_TOKEN=
FLASHMANDU_WEBHOOK_SECRET=
# Used server-side by app/embed/[type]/page.tsx to verify signed storefront
# embed tokens. Leave blank locally to skip that defense-in-depth check.
FLASHMANDU_APP_SECRET=
FLASHMANDU_DEV_BOX_BASE_URL=https://dev.flashmandu.example
PORT=3000
