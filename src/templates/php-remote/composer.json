{
  "name": "acme/autohisab-business-app",
  "description": "Flashmandu app skeleton (PHP, requires flashmandu/app-sdk).",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "~8.4.27 || ^8.5.12",
    "flashmandu/app-sdk": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\AutohisabBusinessApp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@php vendor/bin/pest"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable"
}
