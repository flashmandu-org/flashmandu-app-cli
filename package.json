{
  "name": "@flashmandu/autohisab-business-cli",
  "version": "0.1.8",
  "description": "Developer CLI for AutoHisab Business storefront apps. Build, test and publish apps; Shopify-CLI-equivalent dev tool.",
  "license": "proprietary",
  "author": "Flashmandu <engineering@flashmandu.com>",
  "homepage": "https://github.com/flashmandu-org/flashmandu-app-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashmandu-org/flashmandu-app-cli.git"
  },
  "bugs": {
    "url": "https://github.com/flashmandu-org/flashmandu-app-cli/issues"
  },
  "keywords": [
    "flashmandu",
    "app-cli",
    "storefront-apps",
    "developer-tools"
  ],
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "autohisab-business": "bin/cli.js"
  },
  "files": [
    "dist",
    "src/templates",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "tsx src/index.ts",
    "smoke:scaffold": "node scripts/smoke-scaffold.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "eventsource": "^3.0.2",
    "ora": "^5.4.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "cloudflared": "^0.5.0",
    "ngrok": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
